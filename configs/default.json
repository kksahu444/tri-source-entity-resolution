{
  "data_dir": "dataset",
  "artifacts_dir": "artifacts",
  "output_dir": "output",
  "blocking": {
    "full_char_k": 15,
    "name_word_k": 0,
    "addr_word_k": 5,
    "name_char_k": 0,
    "crowd_k": 10,
    "max_crowd": 2000,
    "blank_name_k": 5,
    "script_k": 10,
    "min_sim": 0.05,
    "char_max_df": 0.02,
    "max_key_block": 30,
    "score_weights": {
      "full_char": 1.0,
      "addr_word": 0.5
    },
    "agree_weight": 0.3,
    "channel_weight": 0.3,
    "max_per_source": 10,
    "train_s1_sample": 1.0,
    "use_embeddings": false,
    "embed_model": "intfloat/multilingual-e5-small",
    "embed_k": 15,
    "reverse_k": 3
  },
  "model": {
    "n_folds": 5,
    "seed": 42,
    "num_boost_round": 3000,
    "early_stopping_rounds": 100,
    "stack": true,
    "lgb_params": {
      "objective": "binary",
      "learning_rate": 0.05,
      "num_leaves": 63,
      "min_data_in_leaf": 40,
      "feature_fraction": 0.8,
      "bagging_fraction": 0.8,
      "bagging_freq": 1,
      "lambda_l2": 1.0,
      "verbose": -1
    }
  },
  "decision": {
    "strategy": "threshold",
    "threshold": 0.5,
    "exclusive": true,
    "tune": true
  }
}
