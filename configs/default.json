{
  "data_dir": "dataset",
  "artifacts_dir": "artifacts",
  "output_dir": "output",
  "blocking": {
    "name_char_k": 15,
    "name_word_k": 10,
    "full_char_k": 15,
    "addr_word_k": 8,
    "min_sim": 0.05,
    "max_key_block": 30,
    "max_candidates": 0,
    "use_embeddings": false,
    "embed_model": "intfloat/multilingual-e5-small",
    "embed_k": 15
  },
  "model": {
    "n_folds": 5,
    "seed": 42,
    "num_boost_round": 3000,
    "early_stopping_rounds": 100,
    "stack": true,
    "lgb_params": {
      "objective": "binary",
      "learning_rate": 0.05,
      "num_leaves": 63,
      "min_data_in_leaf": 40,
      "feature_fraction": 0.8,
      "bagging_fraction": 0.8,
      "bagging_freq": 1,
      "lambda_l2": 1.0,
      "verbose": -1
    }
  },
  "decision": {
    "strategy": "threshold",
    "threshold": 0.5,
    "exclusive": true,
    "tune": true
  }
}
